{
  "name": "p-queue-x",
  "version": "1.0.1",
  "description": "Zero-dependency promise-based concurrency-limited task queue with priority, timeout, pause/resume, and event hooks",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "p-queue-x": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/test/**",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test dist/test/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sulthonzh/p-queue-x"
  },
  "keywords": [
    "queue",
    "promise",
    "concurrency",
    "async",
    "priority",
    "task",
    "p-queue",
    "rate-limit",
    "throttle",
    "zero-dependency"
  ],
  "license": "MIT",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli.mjs",
      "require": "./dist/cli.js"
    }
  },
  "author": "sulthonzh",
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3"
  }
}
